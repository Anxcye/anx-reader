import "../../Fastfile"

default_platform(:android)

platform :android do
  # Ensure required Play Store credentials exist
  private_lane :prepare_play_store do
    unless File.exist?(google_service_account_json_path)
      UI.user_error!("google_service_account.json file not found. Please add it to the root of the flutter project or set GOOGLE_SERVICE_ACCOUNT_JSON_PATH. See https://docs.fastlane.tools/actions/supply/")
    end
  end

  # Build Android bundle or apk with consistent versioning
  private_lane :build_android do
    prepare_play_store

    fetch_dependencies

    build_command = "flutter build appbundle --release --dart-define=isPlayStore=true"

    sh_on_root(command: build_command)
  end

  # Build flutter Android app
  lane :build do
    build_android
  end

  # Release to Play Store using Fastlane Supply (https://docs.fastlane.tools/actions/supply/)
  # Track mapping (Play Console ↔ API): Closed testing=alpha, Open testing=beta,
  # Internal=internal, Production=production.
  # Testing tracks (internal/alpha/beta) publish as completed; production stays draft.
  desc "Release to Play Store"
  lane :release_play_store do |options|
    build_android

    # Accept tracks: "alpha,beta" (comma-separated) or a single track: "internal"
    tracks = if options[:tracks]
               options[:tracks].to_s.split(',').map(&:strip).reject(&:empty?)
             else
               [(options[:track] || 'internal').to_s]
             end

    testing_tracks = %w[internal alpha beta]
    aab_path = "../build/app/outputs/bundle/release/app-release.aab"

    tracks.each do |track|
      release_status = testing_tracks.include?(track) ? 'completed' : 'draft'
      UI.message("Uploading to Play track=#{track} release_status=#{release_status}")

      supply(
        track: track,
        release_status: release_status,
        aab: aab_path,
        json_key: google_service_account_json_path,
        skip_upload_apk: true, # Upload the aab instead of apk
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

end
