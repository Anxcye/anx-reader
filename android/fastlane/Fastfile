import "../../Fastfile"

default_platform(:android)

platform :android do
  # Ensure required Play Store credentials exist
  private_lane :prepare_play_store do
    unless File.exist?(google_service_account_json_path)
      UI.user_error!("google_service_account.json file not found. Please add it to the root of the flutter project or set GOOGLE_SERVICE_ACCOUNT_JSON_PATH. See https://docs.fastlane.tools/actions/supply/")
    end
  end

  # Build Android bundle or apk with consistent versioning
  private_lane :build_android do
    prepare_play_store

    fetch_dependencies

    build_command = "flutter build appbundle --release --dart-define=isPlayStore=true"

    sh_on_root(command: build_command)
  end

  # Build flutter Android app
  lane :build do
    build_android
  end

  # Release to Play Store using Fastlane Supply (https://docs.fastlane.tools/actions/supply/)
  # Track mapping (Play Console ↔ API): Closed testing=alpha, Open testing=beta,
  # Internal=internal, Production=production.
  # Testing tracks (internal/alpha/beta) publish as completed; production stays draft.
  #
  # A version code can only be uploaded once. For multiple tracks we open one Play edit,
  # upload the AAB once, then assign that version code to each track before committing.
  # (Re-uploading or promote_track can fail with "already been used" / precondition errors.)
  desc "Release to Play Store"
  lane :release_play_store do |options|
    build_android

    # Accept tracks: "alpha,beta" (comma-separated) or a single track: "internal"
    tracks = if options[:tracks]
               options[:tracks].to_s.split(',').map(&:strip).reject(&:empty?)
             else
               [(options[:track] || 'internal').to_s]
             end

    testing_tracks = %w[internal alpha beta]
    aab_path = "../build/app/outputs/bundle/release/app-release.aab"

    if tracks.length == 1
      track = tracks.first
      release_status = testing_tracks.include?(track) ? 'completed' : 'draft'
      UI.message("Uploading to Play track=#{track} release_status=#{release_status}")
      supply(
        track: track,
        release_status: release_status,
        aab: aab_path,
        json_key: google_service_account_json_path,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    else
      publish_play_tracks_one_edit(
        tracks: tracks,
        aab: aab_path,
        testing_tracks: testing_tracks
      )
    end
  end

  # Upload AAB once and assign the same version code to multiple tracks in one edit.
  private_lane :publish_play_tracks_one_edit do |options|
    require 'supply'
    require 'supply/client'

    tracks = options[:tracks]
    aab_path = options[:aab]
    testing_tracks = options[:testing_tracks] || %w[internal alpha beta]
    package_name = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
    json_key = File.expand_path(google_service_account_json_path)

    UI.user_error!("package_name missing from Appfile") if package_name.to_s.empty?
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)

    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, {
      json_key: json_key,
      package_name: package_name,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      timeout: 300
    })

    client = Supply::Client.make_from_config
    client.begin_edit(package_name: package_name)

    UI.message("Uploading AAB once for tracks=#{tracks.join(',')}")
    version_code = client.upload_bundle(aab_path)
    UI.success("Uploaded AAB version_code=#{version_code}")

    tracks.each do |track_name|
      release_status = testing_tracks.include?(track_name) ? 'completed' : 'draft'
      UI.message("Assigning version_code=#{version_code} to track=#{track_name} release_status=#{release_status}")

      track_release = AndroidPublisher::TrackRelease.new(
        status: release_status,
        version_codes: [version_code.to_s]
      )
      track_obj = AndroidPublisher::Track.new(
        track: track_name,
        releases: [track_release]
      )
      client.update_track(track_name, track_obj)
    end

    UI.message("Committing Play edit for version_code=#{version_code}")
    client.commit_current_edit!
    UI.success("Successfully published version_code=#{version_code} to tracks=#{tracks.join(',')} with completed testing releases")
  end

end
